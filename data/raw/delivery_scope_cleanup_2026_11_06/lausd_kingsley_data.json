{"document":{"cms":{"tourDates":{"description":"For information about school visits, please contact the school."},"mediaLinks":{"media1":{"alt":"","type":"","base64":null,"filename":"1617901_1.jpg"},"media2":{"alt":"","type":"","base64":null,"filename":"1617901_2.jpg"},"media3":{"alt":"","type":"","base64":null,"filename":"1617901_3.jpg"},"media4":{"alt":"","type":"","base64":null,"filename":"1617901_4.jpg"},"media5":{"alt":"","type":"","base64":null,"filename":"1617901_5.jpg"}},"socialLinks":[{"provider":"facebook","providerId":null},{"provider":"twitter","providerId":null},{"provider":"instagram","providerId":""}],"getToKnowYourSchool":{"description":{"en":"Founded in 2005, Kingsley Elementary School is a TK-5 learning community that immerses students in Common Core aligned tasks to prepare students for the 21st Century.  Students have the choice of two program models:  The English Strand or the Dual Language English/Spanish Program which has earned international attention.  Our instructional program is rooted in the collaboration of best practices such as Reading and Writing Workshop, Literacy Academies, Eureka Math, NGSS and Technology integration.  Our program values Arts integration and a safe school climate. Our dynamic teaching practices have cultivated a partnership with UCLA.  UCLA pre-service teachers conduct their student teaching under the guidance of our faculty. We welcome visitors to our campus and believe it is the best way to get know our exemplary program.","es":"Desde 2005, Kingsley Elementary School es una comunidad escolar TK-5 que sumerge a los alumnos en un currículo común para prepararlos para el siglo XXI. Los alumnos pueden escoger entre dos modelos de programa: el Eje de Inglés o el Programa de Lenguaje Dual Inglés/Español, el cual ha captado la atención internacional. Nuestro programa instructivo está enraizado en la colaboración de las mejores prácticas tales como el Taller de Lectura y Escritura, Academias de Alfabetización, Eureka Math, NGSS e Integración Tecnológica. Nuestro programa valora la integración con Artes y un clima escolar seguro. Nuestras prácticas dinámicas han logrado una alianza con UCLA. Sus docentes de pre-servicio llevan a cabo su enseñanza bajo la guía de nuestro plantel. Aceptamos visitantes y creemos que es la mejor forma de conocer nuestro programa ejemplar."}}},"sst":{"ib":null,"aG1":null,"aG2":null,"aG3":null,"aG4":null,"aG5":null,"cos":"Hollywood Community Of Schools","esl":"100.0","fax":"3239133360","a2CT":null,"asian":"3.2","jrotc":null,"locnx":"Y","meals":"Breakfast|Lunch|Supper","white":"7.7","esL_YR":"2025-2026","absent":"26.7","cosUrl":"https://sites.google.com/lausd.net/hollywood-community-of-schools","gearUp":null,"latino":"84.2","sports":null,"dlpType":null,"nscYear":null,"website":"https://kingsleyes.lausd.org","filipino":"0.7","latitude":"34.0918946729353","sbacYear":"2024-2025","twoYear1":null,"twoYear2":null,"twoYear3":null,"twoYear4":null,"twoYear5":null,"typeCode":"E","avidGrade":null,"dlpGrades":null,"fourYear1":null,"fourYear2":null,"fourYear3":null,"fourYear4":null,"fourYear5":null,"longitude":"-118.3025712432580","startYear":null,"twoOrMore":null,"addressZip":"90029","apCapstone":null,"attendance":"45.3","costCenter":"1617901","decathalon":null,"districtAg":null,"infantCare":null,"magnetName":null,"sasSchools":null,"schoolName":"Kingsley Elementary School","schoolType":"Elementary School","suspension":"0.0","acs_schools":null,"addressCity":"Los Angeles","afc_schools":null,"afterSchool":"STAR Inc.","avidSchools":null,"districtEsl":"100.0","dlpLanguage":null,"dlp_schools":null,"elaSBACMet1":"40.9","elaSBACMet2":null,"elaSBACMet3":null,"gearUpGrade":null,"graduation1":null,"graduation2":null,"graduation3":null,"graduation4":null,"graduation5":null,"magnetTheme":null,"notReported":"2.5","phoneNumber":"(323) 644-7700","pwt_schools":null,"addressState":"CA","adultDaceEsl":null,"awardModelHs":null,"beforeSchool":"Ready-Set-Go!","ethnicity_yr":"2025","magnetG