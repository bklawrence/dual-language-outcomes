{"document":{"cms":{"tourDates":{"description":"For information about school visits, please contact the school."},"mediaLinks":{"media1":{"alt":"","type":"","base64":null,"filename":"1309601_1.jpg"},"media2":{"alt":"","type":"","base64":null,"filename":"1309601_2.jpg"},"media3":{"alt":"","type":"","base64":null,"filename":"1309601_3.jpg"},"media4":{"alt":"","type":"","base64":null,"filename":"1309601_4.jpg"},"media5":{"alt":"","type":"","base64":null,"filename":"1309601_5.jpg"}},"socialLinks":[{"provider":"facebook","providerId":"www.facebook.com/eaglect"},{"provider":"twitter","providerId":null},{"provider":"instagram","providerId":""}],"getToKnowYourSchool":{"description":{"en":"City Terrace Elementary School offers both a General education and Mandarin Dual Language Program. We are one of the pioneers of Mandarin Dual Language Programs, with over 10 years experience. At City Terrace Elementary we strive to offer an environment that is safe, welcoming and hard-working. Teachers and staff are highly effective and focus on providing each student the best education possible. Teachers are patient, creative and focused on teaching students grade level standards. We believe in supporting the development of the \"whole child\" by providing Culturally Linguistic and Responsive instruction and tending to students' social and emotional development. Our goal is to support your child in becoming a productive, accomplished and socially aware citizen of Los Angeles. City Terrace is truly one of Los Angeles' \"Hidden Gems.\"","es":"La escuela primaria City Terrace ofrece un programa de educación general y un programa dual con mandarín. Somos uno de los pioneros de estos programas, con más de 10 años de experiencia. En la City Terrace nos esforzamos por ofrecer un entorno seguro, acogedor y de trabajo. Los profesores y el personal son efectivos y se centran en proporcionar a cada estudiante la mejor educación posible. Los profesores son pacientes, creativos y enseñan a los estudiantes los estándares del curso. Creemos en apoyar el desarrollo del \"niño completo\" al proporcionar instrucción culturalmente lingüística y receptiva y atender el desarrollo social y emocional de los estudiantes. Nuestro objetivo es ayudar a su hijo a convertirse en un ciudadano productivo, exitoso y con conciencia social de Los Ángeles. Es una de las \"gemas ocultas\" de Los Ángeles."}}},"sst":{"ib":null,"aG1":null,"aG2":null,"aG3":null,"aG4":null,"aG5":null,"cos":"Lincoln Heights/El Sereno Community Of Schools","esl":"100.0","fax":"3232679959","a2CT":null,"asian":"4.5","jrotc":null,"locnx":"Y","meals":"Breakfast|Lunch|Supper","white":null,"esL_YR":"2025-2026","absent":"35.0","cosUrl":"https://lincolnelserenocos.lausd.net","gearUp":null,"latino":"87.7","sports":null,"dlpType":null,"nscYear":null,"website":"https://cityterraceelementary.weebly.com/","filipino":null,"latitude":"34.0575856100689","sbacYear":"2024-2025","twoYear1":null,"twoYear2":null,"twoYear3":null,"twoYear4":null,"twoYear5":null,"typeCode":"E","avidGrade":null,"dlpGrades":null,"fourYear1":null,"fourYear2":null,"fourYear3":null,"fourYear4":null,"fourYear5":null,"longitude":"-118.1722451728280","startYear":null,"twoOrMore":"1.9","addressZip":"90063","apCapstone":null,"attendance":"43.1","costCenter":"1309601","decathalon":null,"districtAg":null,"infantCare":null,"magnetName":null,"sasSchools":null,"schoolName":"City Terrace Elementary","schoolType":"Elementary School","suspension":"0.0","acs_schools":null,"addressCity":"Los Angeles","afc_schools":null,"afterSchool":"Youth Development Program","avidSchools":null,"districtEsl":"100.0","dlpLanguage":null,"dlp_schools":null,"elaSBACMet1":"42.6","elaSBACMet2":null,"elaSBACMet3":null,"gearUpGrade":null,"graduation1":null,"graduation2":null,"graduation3":null,"graduation4":null,"graduation5":null,"magnetTheme":null,"notReported":"2.9","phoneNumber":"(323) 269-0581","pwt_schools":null,"addressState":"CA","adultDaceEsl":null,"awardModelHs":null,"beforeSchool