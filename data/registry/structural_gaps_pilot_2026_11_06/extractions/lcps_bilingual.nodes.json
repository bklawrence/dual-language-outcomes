  {
    "id": "28ec1c4e-7b03-4ec6-8a0c-9b39d32a91d3",
    "type": "CONTENT_NODE_TEXT",
    "content": {
      "html": "<p><span style=\"font-size: 16px\">Bilingual Education commits to providing structured and aligned student-focused academic support for Emergent Bilingual, through prompt identification, to promote biliterate/bicultural productive members of our global society.</span></p><p><span style=\"font-size: 16px\">We commit to responsive and continued professional development for all staff based on individual needs and to support academic growth for all students participating in Bilingual Programs.</span></p>"
    }
  },
