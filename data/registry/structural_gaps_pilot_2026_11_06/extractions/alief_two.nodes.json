      "html": "<h1 style=\"text-align: center\">Two Way Dual Language Program Information</h1>"
    }
  },
  {
    "id": "ab72d04b-0be2-4c56-a9ad-4f81866d1330",
    "type": "CONTENT_NODE_SEPARATOR"
  },
  {
    "id": "2abd8d03-805a-4cf8-aab5-1b4f004a29ff",
    "type": "CONTENT_NODE_TEXT",
    "content": {
      "html": "<p><span style=\"font-size: 24px\">Two Way Dual Language Program provides the opportunity for <strong>English</strong> and <strong>Spanish</strong> dominant students to learn how to speak, read and write in Spanish beginning in Kindergarten via a commitment until completion of Grade 6.</span></p>"
    }
