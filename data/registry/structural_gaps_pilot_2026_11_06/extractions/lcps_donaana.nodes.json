  {
    "id": "18348f2a-3a36-4f73-95c4-923eb02ea35d",
    "type": "CONTENT_NODE_TEXT",
    "content": {
      "html": "<p style=\"text-align: center;\"><strong><span style=\"color:unset\">\"Open more doors with two languages\"</span></strong></p><p style=\"text-align: center;\"><strong>\"Abre más puertas a través de dos idiomas\"</strong></p>"
    }
  },
  {
    "id": "0dc8c9c0-c023-4986-b439-35d9d7cf78f6",
    "type": "CONTENT_NODE_HEADING",
    "content": {
      "html": "<h2>Bilingual Program Mission Statement</h2>"
    }
  },
  {
    "id": "59b716bc-1686-44c2-be89-2c7debc4860a",
    "type": "CONTENT_NODE_TEXT",
    "content": {
      "html": "<p><span style=\"font-size: 24px\">Doña Ana Elementary will provide students with cultural, bilingual education incorporating critical thinking skills, life-skills, technology, and content instruction that will enable students to work cooperatively and collaboratively, examine social paradigms, assimilate different viewpoints, and become bilingual and biliterate.</span></p>"
    }
  },
  {
    "id": "bd0e5c74-7082-4496-adcd-93aab25aa593",
    "type": "CONTENT_NODE_TEXT",
    "content": {
      "html": "<p><span style=\"font-size: 18px\">Hilda Chappell<br></span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:mperez2@lcps.net\"><span style=\"font-size: 18px\"><strong>hchappell@lcps.net</strong></span></a><span style=\"font-size: 18px\"><br>Kindergarten <br><br>Veronica Galvan<br></span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:hchappell@lcps.net\"><span style=\"font-size: 18px\"><strong>vgalvan@lcps.net</strong></span></a><span style=\"font-size: 18px\"><br>1st Grade <br><br>Inez Rios-Soto<br></span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:sisoto@lcps.net\"><span style=\"font-size: 18px\"><strong>sisoto@lcps.net</strong></span></a><span style=\"font-size: 18px\"><br>2nd Grade&nbsp;</span></p><p><span style=\"font-size: 18px\">Hugo Morales<br></span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:sisoto@lcps.net\"><span style=\"font-size: 18px\"><strong>hmorales1@lcps.net</strong></span></a><span style=\"font-size: 18px\"><br>3rd Grade&nbsp;</span></p><p><span style=\"font-size: 18px\">Annette Arguello<br></span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"mailto:aarguell@lcps.k12.nm.us\"><span style=\"font-size: 18px\"><strong>aarguell@lcps.net</strong></span></a><span style=\"font-size: 18px\"><br>4th Grade</span></p><p><span style=\"font-size: 18px\">Patricia Guerra<br></span><a target=\"_self\" rel=\"noopener noreferrer nofollow\" href=\"mailto:pguerra@lcps.net\"><span style=\"font-size: 18px\"><strong>pguerra@lcps.net</strong></span></a><span style=\"font-size: 18px\"><br>5th Grade</span></p><p><span style=\"font-size: 18px\">Cristina Pera<br><strong>cperea@lcps.net</strong><br>Bilingual Title I Interventionist</span></p><p><span style=\"font-size: 18px\">Sylvia Ramirez</span></p><p><span style=\"font-size: 18px\">syramirez@lcps.net</span></p><p><span style=\"font-size: 18px\">Bilingual Educational Assistant</span></p><p></p><p></p>"
    }
  },
  {
    "id": "c9c2d164-9d66-47cd-9c9e-d95b4d8c2664",
    "type": "CONTENT_NODE_HEADING",
    "content": {
      "html": "<h1>Learning Resources: </h1>"
    }
  },
  {
    "id": "9a7021c2-7731-4522-9c1d-d7302e901e61",
    "type": "CONTENT_NODE_TEXT",
    "content": {
      "html": "<p><strong><span style=\"font-size: 18px\">Common Core in Español:</span></strong><span style=\"font-size: 18px\"> This bilingual edition offers easy access to side-by-side English/Spanish standards. </span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://commoncore-espanol.sdcoe.net/\"><span style=\"font-size: 18px\">https://commoncore-espanol.sdcoe.net/</span></a></p><p><strong><span style=\"font-size: 18px\">WIDA: </span></strong><span style=\"font-size: 18px\">Videos, webinars, materials for educators and families for ACCESS and ELD standards. </span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://wida.wisc.edu/resources?keys=&amp;field_category%5B3%5D=3\"><span style=\"font-size: 18px\">https://wida.wisc.edu/resources?keys=&amp;field_category%5B3%5D=3</span></a></p><p><strong><span style=\"font-size: 18px\">News ELA: </span></strong><span style=\"font-size: 18px\">Current new topics available at different reading levels in Spanish and English. </span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://newsela.com/\"><span style=\"font-size: 18px\">https://newsela.com/</span></a></p><p><strong><span style=\"font-size: 18px\">Reading Rockets: </span></strong><span style=\"font-size: 18px\">Vast resources and recommendations for effective literacy instruction for English learners. </span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.readingrockets.org/\"><span style=\"font-size: 18px\">https://www.readingrockets.org/</span></a></p><p><strong><span style=\"font-size: 18px\">Colorin Colorado: </span></strong><span style=\"font-size: 18px\">A bilingual site for educators and families of English learners. </span><a target=\"_blank\" rel=\"noopener noreferrer nofollow\" href=\"https://www.colorincolorado.org/\"><span style=\"font-size: 18px\">https://www.colorincolorado.org/</span></a></p><p></p>"
    }
  },
