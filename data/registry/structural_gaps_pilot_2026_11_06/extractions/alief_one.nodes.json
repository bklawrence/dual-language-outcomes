    "content": {
      "html": "<table style=\"width: 100%; min-width: 300px\"><colgroup><col style=\"min-width: 100px\"><col style=\"min-width: 100px\"><col style=\"min-width: 100px\"></colgroup><tbody><tr><th colspan=\"1\" rowspan=\"1\" scope=\"col\"><p>Subject</p></th><th colspan=\"1\" rowspan=\"1\" scope=\"col\"><p>K-1</p></th><th colspan=\"1\" rowspan=\"1\" scope=\"col\"><p>2nd - 6th</p></th></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Language Arts</p></td><td colspan=\"1\" rowspan=\"1\"><p>Spanish</p></td><td colspan=\"1\" rowspan=\"1\"><p>Spanish &amp; English</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Science</p></td><td colspan=\"1\" rowspan=\"1\"><p>Spanish</p></td><td colspan=\"1\" rowspan=\"1\"><p>Spanish</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Social Studies</p></td><td colspan=\"1\" rowspan=\"1\"><p>Spanish</p></td><td colspan=\"1\" rowspan=\"1\"><p>Spanish</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Math</p></td><td colspan=\"1\" rowspan=\"1\"><p>English</p></td><td colspan=\"1\" rowspan=\"1\"><p>English</p></td></tr><tr><td colspan=\"1\" rowspan=\"1\"><p>Enrichment Classes (Art, Music, P.E., Health)</p></td><td colspan=\"1\" rowspan=\"1\"><p>English</p></td><td colspan=\"1\" rowspan=\"1\"><p>English</p></td></tr></tbody></table>"
    }
  },
